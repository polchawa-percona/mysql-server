DROP TABLE IF EXISTS t1;
#
# Case1: Primary key is large, spatial index can be created but we can't insert a row.
#
CREATE TABLE t1 (
a VARCHAR(255) NOT NULL,
b VARCHAR(255) NOT NULL,
c VARCHAR(255) NOT NULL,
d VARCHAR(175) NOT NULL,
g GEOMETRY NOT NULL SRID 4326,
PRIMARY KEY (a, b, c, d),
SPATIAL KEY idx_g (g)
) ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=2 CHARSET=latin1;
INSERT INTO t1(a,b,c,d,g) VALUES ('a', 'b', 'c', 'd', ST_GeomFromText('POINT(37.7749 -122.4194)', 4326));
SELECT a,b,c,d FROM t1;
a	b	c	d
a	b	c	d
DROP TABLE t1;
#
# Case2: We have a table with row and we want to recreate PK, but it would lead to too-big row => rejected.
#
CREATE TABLE t1 (
a VARCHAR(255) NOT NULL,
b VARCHAR(255) NOT NULL,
c VARCHAR(255) NOT NULL,
d VARCHAR(175) NOT NULL,
g GEOMETRY NOT NULL SRID 4326,
PRIMARY KEY (a),
SPATIAL KEY idx_g (g)
) ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=2 CHARSET=latin1;
INSERT INTO t1(a,b,c,d,g) VALUES ('a', 'b', 'c', 'd', ST_GeomFromText('POINT(37.7749 -122.4194)', 4326));
SELECT a,b,c,d FROM t1;
a	b	c	d
a	b	c	d
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY (a,b,c,d);
SELECT a,b,c,d FROM t1;
a	b	c	d
a	b	c	d
SHOW INDEX FROM t1;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t1	0	PRIMARY	1	a	A	1	NULL	NULL		BTREE			YES	NULL
t1	0	PRIMARY	2	b	A	1	NULL	NULL		BTREE			YES	NULL
t1	0	PRIMARY	3	c	A	1	NULL	NULL		BTREE			YES	NULL
t1	0	PRIMARY	4	d	A	1	NULL	NULL		BTREE			YES	NULL
t1	1	idx_g	1	g	A	1	32	NULL		SPATIAL			YES	NULL
DROP TABLE t1;
